  "description": "Find voices and compare model capabilities using JSON metadata. This connector does not synthesize or stream audio.",
  "tools": [
    {
      "name": "list_voices",
      "description": "Search available voices with an explicit next-page token.",
      "method": "GET",
      "path": "/v2/voices",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "next_page_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "search": "search",
          "page_size": "page_size",
          "next_page_token": "next_page_token"
        },
        "body": {}
      },
      "sampleArguments": {
        "search": "narration",
        "page_size": 10
      },
      "provenance": [
        "https://api.elevenlabs.io/openapi.json"
      ],
      "pagination": {
        "type": "cursor",
        "cursorInput": "next_page_token",
        "nextCursorPath": "next_page_token",
        "hasMorePath": "has_more"
      }
    },
    {
      "name": "list_models",
      "description": "Compare model capabilities and supported languages before selecting a voice workflow.",
      "method": "GET",
      "path": "/v1/models",
